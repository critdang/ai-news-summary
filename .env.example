# ╔════════════════════════════════════════════════════════════════════╗
# ║  AI News Summary — Configuration                                    ║
# ╚════════════════════════════════════════════════════════════════════╝
# Copy this file to .env and fill in the values.
# Never commit real API keys, tokens or passwords to version control.

# ── Database (Supabase PostgreSQL) ─────────────────────────────────
# Get DATABASE_URL from Supabase → Settings → Database → Connection string.
# Use the pooled connection string (port 6543) for serverless/Vercel.
DATABASE_URL="postgresql://postgres:<password>@<host>:<port>/postgres?schema=public"
# Prisma migrations should use a direct or session-pooled connection, not the
# transaction pooler. Leave this unset only when DATABASE_URL is direct/session.
DIRECT_URL="postgresql://postgres:<password>@<host>:5432/postgres?schema=public"

# ── Application ────────────────────────────────────────────────────
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# ── AI Providers (Groq primary, Gemini fallback) ──────────────────
# Get keys from Google AI Studio (Gemini) and Groq Console.
# Only used by the server-side ingestion worker and API routes — never browser code.
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
# Bootstrap defaults only. Saved account preferences in Settings take precedence.
AI_PROVIDER="groq"              # gemini | groq | mock
AI_MODEL="gemini-3.8-flash"     # Gemini default model
GROQ_MODEL="openai/gpt-oss-20b" # Groq default model
AI_TIMEOUT_MS="15000"
AI_MAX_RETRIES="3"

# ── Ingestion ──────────────────────────────────────────────────────
# Bootstrap default summary language (vi = Vietnamese). Change saved preferences in Settings.
DEFAULT_LANGUAGE="vi"
# Bootstrap default retention in days (30-60). Change saved preferences in Settings.
RETENTION_DAYS="45"
# Bootstrap total new-article budget across feeds per run (1–50). Change saved preferences in Settings.
# Divided evenly among feeds unless feed-specific allocations are configured.
MAX_ARTICLES_PER_RUN="50"
# Feed fetch concurrency for the scheduled RSS metadata worker.
FEED_FETCH_CONCURRENCY="4"

# ── Vercel ────────────────────────────────────────────────────────
# Vercel Cron sends this secret to the scheduled ingestion and cleanup routes.
# Keep it server-only; never use a NEXT_PUBLIC_ prefix.
CRON_SECRET="random-long-cron-secret"

# ── GitHub discovery (optional) ───────────────────────────────────
# Server-only public API token for a higher GitHub API rate limit.
# Repository discovery works without a token at GitHub's anonymous limit.
GITHUB_TOKEN=""
