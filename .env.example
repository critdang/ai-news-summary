# ╔════════════════════════════════════════════════════════════════════╗
# ║  AI News Summary — Configuration                                    ║
# ╚════════════════════════════════════════════════════════════════════╝
# Copy this file to .env and fill in the values.
# Never commit real API keys, tokens or passwords to version control.

# ── Database (Supabase PostgreSQL) ─────────────────────────────────
# Get DATABASE_URL from Supabase → Settings → Database → Connection string.
# Use the pooled connection string (port 6543) for serverless/Vercel.
DATABASE_URL="postgresql://postgres:<password>@<host>:<port>/postgres?schema=public"
# Prisma migrations should use a direct or session-pooled connection, not the
# transaction pooler. Leave this unset only when DATABASE_URL is direct/session.
DIRECT_URL="postgresql://postgres:<password>@<host>:5432/postgres?schema=public"

# ── Application ────────────────────────────────────────────────────
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI Providers (Groq primary, Gemini fallback) ──────────────────
# Get keys from Google AI Studio (Gemini) and Groq Console.
# Only used by the server-side ingestion worker and API routes — never browser code.
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
AI_PROVIDER="groq"              # gemini | groq | mock
AI_MODEL="gemini-3.8-flash"
GROQ_MODEL="openai/gpt-oss-20b"
AI_TIMEOUT_MS="15000"
AI_MAX_RETRIES="3"
MAX_ARTICLE_RETRIES_PER_RUN="25"

# ── Ingestion ──────────────────────────────────────────────────────
# Default summary language (vi = Vietnamese). Configurable in Settings.
DEFAULT_LANGUAGE="vi"
# Default article retention in days (30-60). Expired unbookmarked articles are removed.
RETENTION_DAYS="45"
# Total new-article budget across all feeds per ingestion run (1–50).
# Divided evenly among feeds unless feed-specific allocations are configured.
MAX_ARTICLES_PER_RUN="50"
# Batch safety and throughput limits. Provider token usage is reported when supported;
# estimated input tokens use the rough chars/4 heuristic.
MAX_ARTICLES_PER_BATCH="15"
MAX_BATCH_INPUT_CHARS="20000"
MAX_ARTICLE_EXCERPT_CHARS="1200"
MAX_AI_CALLS_PER_RUN="20"
FEED_FETCH_CONCURRENCY="4"
AI_BATCH_CONCURRENCY="2"

# ── GitHub Actions ─────────────────────────────────────────────────
# Configure DATABASE_URL, GEMINI_API_KEY, and/or GROQ_API_KEY as Actions
# repository secrets. DATABASE_URL is used only by server/worker code, never
# exposed to browser code. RETENTION_DAYS may also be set as an Actions variable.
