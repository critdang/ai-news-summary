# ╔════════════════════════════════════════════════════════════════════╗
# ║  AI News Summary — Configuration                                    ║
# ╚════════════════════════════════════════════════════════════════════╝
# Copy this file to .env and fill in the values.
# Never commit real API keys, tokens or passwords to version control.

# ── Database (Supabase PostgreSQL) ─────────────────────────────────
# Get DATABASE_URL from Supabase → Settings → Database → Connection string.
# Use the pooled connection string (port 6543) for serverless/Vercel.
DATABASE_URL="postgresql://postgres:<password>@<host>:<port>/postgres?schema=public"
# Prisma migrations should use a direct or session-pooled connection, not the
# transaction pooler. Leave this unset only when DATABASE_URL is direct/session.
DIRECT_URL="postgresql://postgres:<password>@<host>:5432/postgres?schema=public"

# ── Application ────────────────────────────────────────────────────
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI Providers (Gemini primary, Groq fallback) ───────────────────
# Get keys from Google AI Studio (Gemini) and Groq Console.
# Only used by the server-side ingestion worker and API routes — never browser code.
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
AI_PROVIDER="gemini"            # gemini | groq
AI_MODEL="gemini-1.5-flash"
AI_TIMEOUT_MS="15000"
AI_MAX_RETRIES="3"

# ── Ingestion ──────────────────────────────────────────────────────
# Default summary language (vi = Vietnamese). Configurable in Settings.
DEFAULT_LANGUAGE="vi"
# Default article retention in days (30-60). Expired unbookmarked articles are removed.
RETENTION_DAYS="45"
# Max articles fetched per source per run (limits AI cost and DB writes).
MAX_ARTICLES_PER_SOURCE="20"

# ── GitHub Actions (worker) ────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY is set only in GitHub Actions Secrets (not in .env).
# It must NEVER be exposed to the browser or committed to source control.
